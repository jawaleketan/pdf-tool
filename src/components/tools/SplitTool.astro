---
/**
    SplitTool: Interactive browser-based PDF splitting island.
    Uses createToolWorker('split') to process PDFs via Web Worker.
    Zero main-thread blocking, fully responsive, accessible (WCAG 2.1 AA).
*/
---

<div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm" data-split-tool>
  <h2 class="text-xl font-bold text-gray-900">Split PDF Files</h2>
  <p class="mt-1 text-sm text-gray-600">
    Extract specific pages, page ranges, or split every page into separate files instantly in your
    browser. 100% private.
  </p>

  <!-- Dropzone -->
  <div
    class="mt-6 flex flex-col items-center justify-center rounded-lg border-2 border-dashed border-gray-300 p-8 text-center hover:border-indigo-500 focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-500"
    id="split-dropzone"
  >
    <svg
      class="h-12 w-12 text-gray-400"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"
      />
    </svg>
    <label
      for="split-file-input"
      class="mt-4 cursor-pointer text-sm font-medium text-indigo-600 hover:text-indigo-500"
    >
      <span>Choose PDF file</span>
      <input
        id="split-file-input"
        name="split-file-input"
        type="file"
        accept=".pdf,application/pdf"
        class="sr-only"
      />
    </label>
    <p class="mt-1 text-xs text-gray-500">or drag and drop a PDF file here</p>
  </div>

  <!-- File Configuration & Controls -->
  <div id="split-config-container" class="mt-6 hidden space-y-6">
    <div class="flex items-center justify-between rounded-lg border border-gray-200 bg-gray-50 p-4">
      <div class="flex items-center space-x-3 truncate">
        <svg
          class="h-8 w-8 text-indigo-600 flex-shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
          />
        </svg>
        <div class="truncate">
          <p id="selected-file-name" class="text-sm font-semibold text-gray-900 truncate">
            document.pdf
          </p>
          <p id="selected-file-meta" class="text-xs text-gray-500">
            0 KB
          </p>
        </div>
      </div>
      <button
        type="button"
        id="split-clear-btn"
        class="text-sm font-medium text-rose-600 hover:text-rose-800"
      >
        Remove
      </button>
    </div>

    <!-- Split Mode Selection -->
    <div>
      <label class="block text-sm font-semibold text-gray-900">Split Mode</label>
      <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <label
          class="relative flex cursor-pointer rounded-lg border bg-white p-4 shadow-sm focus:outline-none border-indigo-600 ring-2 ring-indigo-600"
          id="mode-every-label"
        >
          <input type="radio" name="split-mode" value="every" checked class="sr-only" />
          <span class="flex flex-col">
            <span class="block text-sm font-medium text-gray-950">Split every page</span>
            <span class="block text-xs text-gray-500 mt-1">
              Extract each page into its own PDF (ZIP).
            </span>
          </span>
        </label>
        <label
          class="relative flex cursor-pointer rounded-lg border bg-white p-4 shadow-sm focus:outline-none border-gray-200"
          id="mode-range-label"
        >
          <input type="radio" name="split-mode" value="range" class="sr-only" />
          <span class="flex flex-col">
            <span class="block text-sm font-medium text-gray-950">Page range</span>
            <span class="block text-xs text-gray-500 mt-1">
              Extract a continuous range of pages.
            </span>
          </span>
        </label>
        <label
          class="relative flex cursor-pointer rounded-lg border bg-white p-4 shadow-sm focus:outline-none border-gray-200"
          id="mode-extract-label"
        >
          <input type="radio" name="split-mode" value="extract" class="sr-only" />
          <span class="flex flex-col">
            <span class="block text-sm font-medium text-gray-950">Extract pages</span>
            <span class="block text-xs text-gray-500 mt-1">
              Extract specific comma-separated pages.
            </span>
          </span>
        </label>
      </div>
    </div>

    <!-- Mode Options -->
    <div
      id="range-options"
      class="hidden rounded-lg border border-gray-200 bg-gray-50 p-4 space-y-4"
    >
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="range-start" class="block text-xs font-medium text-gray-700">
            From page
          </label>
          <input
            type="number"
            id="range-start"
            min="1"
            value="1"
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border p-2"
          />
        </div>
        <div>
          <label for="range-end" class="block text-xs font-medium text-gray-700">
            To page
          </label>
          <input
            type="number"
            id="range-end"
            min="1"
            value="1"
            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border p-2"
          />
        </div>
      </div>
    </div>

    <div
      id="extract-options"
      class="hidden rounded-lg border border-gray-200 bg-gray-50 p-4 space-y-2"
    >
      <label for="extract-pages" class="block text-xs font-medium text-gray-700">
        Pages to extract (e.g., 1, 3, 5-8)
      </label>
      <input
        type="text"
        id="extract-pages"
        placeholder="1, 3, 5"
        class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm border p-2"
      />
    </div>

    <div class="flex justify-end">
      <button
        type="button"
        id="split-btn"
        class="inline-flex items-center rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2 disabled:opacity-50"
      >
        Split PDF
      </button>
    </div>
  </div>

  <!-- Progress & Status -->
  <div id="split-status-container" class="mt-6 hidden">
    <div class="flex justify-between text-sm font-medium text-gray-700">
      <span id="split-status-text">Splitting PDF…</span>
      <span id="split-progress-percent">0%</span>
    </div>
    <div class="mt-2 h-2.5 w-full rounded-full bg-gray-200">
      <div
        id="split-progress-bar"
        class="h-2.5 rounded-full bg-indigo-600 transition-all duration-300"
        style="width: 0%"
      ></div>
    </div>
  </div>

  <!-- Result / Download -->
  <div
    id="split-result-container"
    class="mt-6 hidden rounded-lg border border-emerald-200 bg-emerald-50 p-4 text-center"
  >
    <p class="text-sm font-semibold text-emerald-800">Your PDF was split successfully!</p>
    <a
      id="split-download-link"
      href="#"
      download="split-result.pdf"
      class="mt-3 inline-flex items-center rounded-lg bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:ring-offset-2"
    >
      Download Split Result
    </a>
  </div>

  <!-- Error Alert -->
  <div
    id="split-error-container"
    class="mt-6 hidden rounded-lg border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800"
  >
    <span id="split-error-text">An error occurred while splitting PDF.</span>
  </div>
</div>

<script>
  import { createToolWorker } from '../../lib/pdf/createToolWorker';

  let selectedFile: File | null = null;

  const fileInput = document.getElementById('split-file-input') as HTMLInputElement;
  const dropzone = document.getElementById('split-dropzone') as HTMLElement;
  const configContainer = document.getElementById('split-config-container') as HTMLElement;
  const fileNameEl = document.getElementById('selected-file-name') as HTMLElement;
  const fileMetaEl = document.getElementById('selected-file-meta') as HTMLElement;
  const clearBtn = document.getElementById('split-clear-btn') as HTMLButtonElement;
  const splitBtn = document.getElementById('split-btn') as HTMLButtonElement;
  const statusContainer = document.getElementById('split-status-container') as HTMLElement;
  const statusText = document.getElementById('split-status-text') as HTMLElement;
  const progressBar = document.getElementById('split-progress-bar') as HTMLElement;
  const progressPercent = document.getElementById('split-progress-percent') as HTMLElement;
  const resultContainer = document.getElementById('split-result-container') as HTMLElement;
  const downloadLink = document.getElementById('split-download-link') as HTMLAnchorElement;
  const errorContainer = document.getElementById('split-error-container') as HTMLElement;
  const errorText = document.getElementById('split-error-text') as HTMLElement;

  const rangeOptions = document.getElementById('range-options') as HTMLElement;
  const extractOptions = document.getElementById('extract-options') as HTMLElement;
  const rangeStartInput = document.getElementById('range-start') as HTMLInputElement;
  const rangeEndInput = document.getElementById('range-end') as HTMLInputElement;
  const extractPagesInput = document.getElementById('extract-pages') as HTMLInputElement;

  const modeLabels = {
    every: document.getElementById('mode-every-label') as HTMLElement,
    range: document.getElementById('mode-range-label') as HTMLElement,
    extract: document.getElementById('mode-extract-label') as HTMLElement,
  };

  function formatFileSize(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  function setFile(file: File) {
    selectedFile = file;
    fileNameEl.textContent = file.name;
    fileMetaEl.textContent = formatFileSize(file.size);
    configContainer.classList.remove('hidden');
    dropzone.classList.add('hidden');
    errorContainer.classList.add('hidden');
    resultContainer.classList.add('hidden');
  }

  fileInput.addEventListener('change', () => {
    if (fileInput.files && fileInput.files[0]) {
      setFile(fileInput.files[0]);
      fileInput.value = '';
    }
  });

  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('border-indigo-500', 'bg-indigo-50/50');
  });

  dropzone.addEventListener('dragleave', () => {
    dropzone.classList.remove('border-indigo-500', 'bg-indigo-50/50');
  });

  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('border-indigo-500', 'bg-indigo-50/50');
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
      const file = e.dataTransfer.files[0];
      if (file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf')) {
        setFile(file);
      }
    }
  });

  clearBtn.addEventListener('click', () => {
    selectedFile = null;
    configContainer.classList.add('hidden');
    dropzone.classList.remove('hidden');
    resultContainer.classList.add('hidden');
    errorContainer.classList.add('hidden');
  });

  document.querySelectorAll('input[name="split-mode"]').forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const val = (e.target as HTMLInputElement).value;

      // Update styling
      Object.keys(modeLabels).forEach((k) => {
        const lbl = modeLabels[k as keyof typeof modeLabels];
        if (k === val) {
          lbl.classList.add('border-indigo-600', 'ring-2', 'ring-indigo-600');
          lbl.classList.remove('border-gray-200');
        } else {
          lbl.classList.remove('border-indigo-600', 'ring-2', 'ring-indigo-600');
          lbl.classList.add('border-gray-200');
        }
      });

      if (val === 'range') {
        rangeOptions.classList.remove('hidden');
        extractOptions.classList.add('hidden');
      } else if (val === 'extract') {
        rangeOptions.classList.add('hidden');
        extractOptions.classList.remove('hidden');
      } else {
        rangeOptions.classList.add('hidden');
        extractOptions.classList.add('hidden');
      }
    });
  });

  splitBtn.addEventListener('click', async () => {
    if (!selectedFile) return;

    const modeRadio = document.querySelector(
      'input[name="split-mode"]:checked',
    ) as HTMLInputElement;
    const mode = modeRadio ? modeRadio.value : 'every';

    let rangeStart = parseInt(rangeStartInput.value, 10);
    let rangeEnd = parseInt(rangeEndInput.value, 10);
    const pages: number[] = [];

    if (mode === 'range') {
      if (isNaN(rangeStart) || rangeStart < 1) rangeStart = 1;
      if (isNaN(rangeEnd) || rangeEnd < rangeStart) rangeEnd = rangeStart;
    } else if (mode === 'extract') {
      const raw = extractPagesInput.value;
      const parts = raw.split(',');
      for (const part of parts) {
        const trimmed = part.trim();
        if (trimmed.includes('-')) {
          const [startStr, endStr] = trimmed.split('-');
          const s = parseInt(startStr, 10);
          const e = parseInt(endStr, 10);
          if (!isNaN(s) && !isNaN(e) && s <= e) {
            for (let p = s; p <= e; p++) pages.push(p);
          }
        } else {
          const p = parseInt(trimmed, 10);
          if (!isNaN(p)) pages.push(p);
        }
      }
      if (pages.length === 0) {
        errorText.textContent = 'Please enter valid page numbers to extract (e.g. 1, 3, 5-8).';
        errorContainer.classList.remove('hidden');
        return;
      }
    }

    splitBtn.disabled = true;
    errorContainer.classList.add('hidden');
    resultContainer.classList.add('hidden');
    statusContainer.classList.remove('hidden');
    progressBar.style.width = '0%';
    progressPercent.textContent = '0%';
    statusText.textContent = 'Reading PDF file…';

    try {
      const arrayBuffer = await selectedFile.arrayBuffer();
      const worker = createToolWorker('split');

      worker.run(
        [arrayBuffer],
        { mode, rangeStart, rangeEnd, pages },
        {
          onProgress: (percent) => {
            progressBar.style.width = `${percent}%`;
            progressPercent.textContent = `${percent}%`;
            if (percent < 50) {
              statusText.textContent = 'Analyzing document…';
            } else {
              statusText.textContent = 'Generating split files…';
            }
          },
          onResult: ({ file, name }) => {
            worker.terminate();
            statusContainer.classList.add('hidden');
            splitBtn.disabled = false;

            const mimeType = name.endsWith('.zip') ? 'application/zip' : 'application/pdf';
            const blob = new Blob([file], { type: mimeType });
            const url = URL.createObjectURL(blob);
            downloadLink.href = url;
            downloadLink.download = name || 'split-result.pdf';
            downloadLink.textContent = name.endsWith('.zip')
              ? 'Download Split ZIP'
              : 'Download Split PDF';
            resultContainer.classList.remove('hidden');
          },
          onError: (message) => {
            worker.terminate();
            statusContainer.classList.add('hidden');
            splitBtn.disabled = false;
            errorText.textContent = message;
            errorContainer.classList.remove('hidden');
          },
        },
      );
    } catch (err) {
      splitBtn.disabled = false;
      statusContainer.classList.add('hidden');
      errorText.textContent = err instanceof Error ? err.message : 'Failed to read PDF file.';
      errorContainer.classList.remove('hidden');
    }
  });
</script>
