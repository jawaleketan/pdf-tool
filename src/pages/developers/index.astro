---
/**
    Developer API Documentation Page (/developers)
    Public documentation for the PDF Utilities Developer API (Release 9).
*/
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Developer API — PDF Utilities';
const description = 'Integrate powerful PDF conversion and processing into your applications with our secure, high-performance developer API.';
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="border-b border-gray-200 pb-5">
      <span class="inline-flex items-center rounded-full bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700 ring-1 ring-inset ring-indigo-600/20 mb-3">
        Release 9 · Public API
      </span>
      <h1 class="text-3xl font-bold tracking-tight text-gray-900">PDF Utilities Developer API</h1>
      <p class="mt-2 text-base text-gray-600">
        Integrate PDF-to-Word conversion, compression, and document processing directly into your backend workflows and web applications.
      </p>
    </div>

    <div class="mt-8 space-y-10 text-gray-700">
      <!-- Authentication -->
      <section class="space-y-4">
        <h2 class="text-xl font-bold text-gray-900">1. Authentication</h2>
        <p>
          All API requests to <code class="rounded bg-gray-100 px-1.5 py-0.5 text-sm font-mono text-indigo-600">/api/v1/*</code> require an API key. You can pass your key using either the <code class="rounded bg-gray-100 px-1.5 py-0.5 text-sm font-mono text-gray-800">X-API-Key</code> header or the HTTP Bearer token format.
        </p>
        <div class="rounded-lg bg-gray-900 p-4 text-sm font-mono text-gray-100 overflow-x-auto">
          <pre>X-API-Key: pdf_live_your_api_key_here
# or
Authorization: Bearer pdf_live_your_api_key_here</pre>
        </div>
      </section>

      <!-- Rate Limits -->
      <section class="space-y-4">
        <h2 class="text-xl font-bold text-gray-900">2. Rate Limits & Quotas</h2>
        <p>
          Standard API keys are limited to <strong>100 requests per hour</strong>. Rate limit status is returned in the response headers of every request:
        </p>
        <ul class="list-disc pl-5 space-y-1 text-sm">
          <li><code class="font-mono text-indigo-600">X-RateLimit-Limit</code>: Maximum requests allowed in the current window.</li>
          <li><code class="font-mono text-indigo-600">X-RateLimit-Remaining</code>: Number of remaining requests available.</li>
          <li><code class="font-mono text-indigo-600">X-RateLimit-Reset</code>: Unix timestamp when the rate limit window resets.</li>
        </ul>
      </section>

      <!-- Endpoints -->
      <section class="space-y-6">
        <h2 class="text-xl font-bold text-gray-900">3. Endpoints</h2>

        <!-- Convert Endpoint -->
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <span class="inline-flex items-center rounded-md bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 ring-1 ring-inset ring-emerald-600/20 font-mono">
              POST /api/v1/convert
            </span>
            <span class="text-xs text-gray-500">Multipart form-data</span>
          </div>
          <p class="text-sm text-gray-600">
            Uploads a PDF file and converts it into a Microsoft Word (<code class="font-mono">.docx</code>) document.
          </p>

          <div class="space-y-2">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500">Example Request (cURL)</h3>
            <div class="rounded-lg bg-gray-900 p-4 text-xs font-mono text-gray-100 overflow-x-auto">
              <pre>curl -X POST https://pdf-utils.pages.dev/api/v1/convert \
  -H "X-API-Key: pdf_live_sample_key" \
  -F "file=@document.pdf" \
  --output document.docx</pre>
            </div>
          </div>

          <div class="space-y-2">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-500">Example Request (JavaScript / Fetch)</h3>
            <div class="rounded-lg bg-gray-900 p-4 text-xs font-mono text-gray-100 overflow-x-auto">
              <pre>const formData = new FormData();
formData.append('file', fileInput.files[0]);

const response = await fetch('https://pdf-utils.pages.dev/api/v1/convert', &#123;
  method: 'POST',
  headers: &#123;
    'X-API-Key': 'pdf_live_sample_key'
  &#125;,
  body: formData
&#125;);

if (response.ok) &#123;
  const blob = await response.blob();
  // Download or process blob (.docx)
&#125;</pre>
            </div>
          </div>
        </div>
      </section>

      <!-- Security & Privacy -->
      <section class="space-y-4">
        <h2 class="text-xl font-bold text-gray-900">4. Privacy & Deletion Policy</h2>
        <p class="text-sm text-gray-600">
          Files uploaded to the API are handled with strict zero-persistence policies. Documents are processed entirely in memory and permanently deleted immediately after the response stream completes.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
