---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkerProbe from '../../components/WorkerProbe.astro';
import AdSlot from '../../components/AdSlot.astro';

export async function getStaticPaths() {
  const variants = await getCollection('variants');
  return variants.map((variant) => {
    return {
      params: {
        tool: variant.data.toolId,
        slug: variant.data.slug,
      },
      props: { variant },
    };
  });
}

const { variant } = Astro.props;
const { Content } = await render(variant);

const toolId = variant.data.toolId;
const toolHref = toolId === 'merge' ? '/' : `/${toolId}`;
const toolName =
  toolId === 'merge'
    ? 'Merge PDF'
    : toolId === 'split'
      ? 'Split PDF'
      : toolId === 'compress'
        ? 'Compress PDF'
        : 'PDF to Word Converter';
---

<BaseLayout title={`${variant.data.title} — PDF Utilities`} description={variant.data.description}>
  <!-- Hero Section -->
  <section class="py-8 text-center">
    <div class="mb-2">
      <a
        href={toolHref}
        class="text-xs font-semibold text-indigo-600 hover:text-indigo-500 uppercase tracking-wide"
      >
        ← Back to {toolName}
      </a>
    </div>
    <h1 class="text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl">
      {variant.data.heading}
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-gray-600">{variant.data.description}</p>
    <div class="mt-6">
      <a
        href={toolHref}
        class="inline-flex items-center rounded-lg bg-indigo-600 px-6 py-3 text-base font-semibold text-white shadow-sm hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2"
      >
        Launch {toolName} Now →
      </a>
    </div>
  </section>

  <!-- Main Content & Body -->
  <section class="mx-auto max-w-3xl px-4 py-8 prose prose-indigo text-gray-700">
    <Content />
  </section>

  <!-- Ad Slot -->
  <div class="mx-auto max-w-3xl px-4 my-6">
    <AdSlot slotType="sidebar" />
  </div>

  <!-- FAQs Section -->
  {variant.data.faqs && variant.data.faqs.length > 0 && (
    <section class="mx-auto max-w-3xl px-4 py-12 border-t border-gray-200">
      <h2 class="text-2xl font-bold text-gray-900 text-center mb-8">Frequently Asked Questions</h2>
      <div class="space-y-6">
        {variant.data.faqs.map((faq) => (
          <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-semibold text-gray-900">{faq.question}</h3>
            <p class="mt-2 text-sm text-gray-600">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <!-- Footer -->
  <footer class="mt-20 border-t border-gray-200 pt-8 text-center text-sm text-gray-500 space-y-2">
    <div class="flex justify-center space-x-6 text-gray-600">
      <a href="/privacy" class="hover:text-indigo-600">
        Privacy Policy
      </a>
      <a href="/terms" class="hover:text-indigo-600">
        Terms of Service
      </a>
      <a href="/" class="hover:text-indigo-600">
        All Tools
      </a>
    </div>
    <p>© {new Date().getFullYear()} PDF Utilities. All rights reserved.</p>
  </footer>

  <WorkerProbe />
</BaseLayout>
